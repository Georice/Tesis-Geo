# ⚠️ Bloque anterior comentado: contenía un JWT_SECRET real/reutilizable
# expuesto en git. Revisar manualmente y eliminar este bloque antes de
# hacer commit de este archivo.
# PORT=3000
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=managerice_db
# DB_USER=managerice
# DB_PASSWORD=managerice123
# JWT_SECRET=georice_jwt_secret_2025_cambiar_en_produccion_256bits
# JWT_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d

PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=managerice_db
DB_USER=managerice
DB_PASSWORD=<tu-password-local>
# En Railway: activar SSL para la conexión a Postgres.
DB_SSL=false
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# NUNCA reutilizar un valor que haya estado en este archivo o en el historial de git.
JWT_SECRET=<genera-un-valor-aleatorio-fuerte>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Orígenes permitidos para CORS, separados por coma (solo aplica a llamadas
# desde navegador; la app móvil no las necesita). Vacío = ningún origen de
# navegador permitido.
CORS_ORIGIN=